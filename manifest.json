{
  "manifest_version": 3,
  "name": "Azure DevOps - Colored PR Tags",
  "version": "1.0",
  "author": "Simon Storl-Schulke",

  "permissions": ["storage"],

  "host_permissions": [
    "https://dev.azure.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*"
      ],
      "js": ["defaults.js", "colored-prs.js"],
      "run_at": "document_idle"
    }
  ],

  "options_page": "options.html"
}
